<td>
    <a href="{{judges[0].id}}">{{judges[0].name}}</a> <span class="kg-url hidden" data-url="{{judges[0].id}}">🔗</span>
    {% if judges[0].country != '(null)' %}
        <span class="flag-icon flag-icon-{{judges[0].country}}"></span>
    {% endif %}

    {% for judge in judges offset:1 %}
        ,
        <a href="{{judge.id}}">{{judge.name}}</a> <span class="kg-url hidden" data-url="{{judge.id}}">🔗</span>
        {% if judge.country != '(null)' %}
            <span class="flag-icon flag-icon-{{judge.country}}"></span>
        {% endif %}
    {% endfor %}
</td>
