<h4 class="page-title">Battles</h4>

{% if battles %}

<div id="event-battles" class="table-responsive">
    <table class="table">
        <thead>
        <tr>
            <th class="category">Category</th>
            <th class="permanent-date">Date</th>
            <th class="winner">Winner</th>
            <th class="judges">Judges</th>
        </tr>
        </thead>
        <tbody>

        {% assign i = 0 %}

        {% for battle in battles %}
        {% assign m = i | modulo: 2 %}
        <tr class="
            {% if m == "1" %}
        grey-bckgrnd
        {% endif %}
        "
        >
        {% assign i = i | plus: 1 %}
        <td class="battle-only">{{battle.name}} <span class="kg-url hidden" data-url="{{battle.id}}">🔗</span></td>
        <td class="permanent-date">{{battle.formattedDate}}</td>

        {% include winner-cell with battle %}
        {% assign judges = battleToJudges[battle.id] %}
        <td class="judges">
            {% if judges.size > 0 %}
                {% include judge-cell with judges %}
            {% else %}
                Information not available.
            {% endif %}
        </td>

        </tr>
        <tr class="details-sm
            {% if m == "1" %}
            grey-bckgrnd
            {% endif %}
            ">
            <td colspan="1">{{battle.formattedDate}}</td>
            <td colspan="1">
                Judges:
                {% if judges.size > 0 %}
                    {% include judge-cell with judges %}
                {% else %}
                    information not available.
                {% endif %}
            </td>
         </tr>
        {% endfor %}
        </tbody>
    </table>
</div>

{% else %}

<p>
No information about the battles is available yet.
</p>

{% endif %}
