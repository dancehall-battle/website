{% if battle.participants == '1' %}
    <td><a href="/dancer/{{ battle.hasWinner[0].postfix }}">{{ battle.hasWinner[0].name }}</a> <span class="kg-url hidden"
                                                                                        data-url="{{ battle.hasWinner[0].id }}">🔗</span>
        {% if battle.hasWinner[0].country != '(null)' %}
            <span class="flag-icon flag-icon-{{ battle.hasWinner[0].country }}"></span>
        {% endif %}
    </td>
{% elsif battle.participants == '2' %}
    <td><a href="/dancer/{{ battle.hasWinner[0].postfix }}">{{ battle.hasWinner[0].name }}</a> <span class="kg-url hidden"
                                                                                        data-url="{{ battle.hasWinner[0].id }}">🔗</span>
        {% if battle.hasWinner[0].country != '(null)' %}
            <span class="flag-icon flag-icon-{{ battle.hasWinner[0].country }}"></span>
        {% endif %}
        and <a href="/dancer/{{ battle.hasWinner[1].postfix }}">{{ battle.hasWinner[1].name }}</a> <span class="kg-url hidden"
                                                                                            data-url="{{ battle.hasWinner[1].id }}">🔗</span>
        {% if battle.hasWinner[1].country != '(null)' %}
            <span class="flag-icon flag-icon-{{ battle.hasWinner[1].country }}"></span>
        {% endif %}
    </td>
{% else %}
    <td><a href="/dancer/{{ battle.hasWinner[0].postfix }}">{{ battle.hasWinner[0].name }}</a> <span class="kg-url hidden"
                                                                                        data-url="{{ battle.hasWinner[0].id }}">🔗</span>
        {% if battle.hasWinner[0].country != '(null)' %}
            <span class="flag-icon flag-icon-{{ battle.hasWinner[0].country }}"></span>
        {% endif %}
        , <a href="/dancer/{{ battle.hasWinner[1].postfix }}">{{ battle.hasWinner[1].name }}</a> <span class="kg-url hidden"
                                                                                            data-url="{{ battle.hasWinner[1].id }}">🔗</span>
        {% if battle.hasWinner[1].country != '(null)' %}
            <span class="flag-icon flag-icon-{{ battle.hasWinner[1].country }}"></span>
        {% endif %}
        , and <a href="/dancer/{{ battle.hasWinner[2].postfix }}">{{ battle.hasWinner[2].name }}</a> <span class="kg-url hidden"
                                                                                            data-url="{{ battle.hasWinner[1].id }}">🔗</span>
        {% if battle.hasWinner[2].country != '(null)' %}
            <span class="flag-icon flag-icon-{{ battle.hasWinner[2].country }}"></span>
        {% endif %}
    </td>
{% endif %}
